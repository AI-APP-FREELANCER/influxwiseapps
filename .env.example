# ============================================================
# Copy this to apps/{pad,flow,spark,revive,shield,admin}/.env.local
# ============================================================

# Database — Neon Serverless PostgreSQL
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth.js
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://pad.influxwise.com"  # change per app

# Google OAuth (same credentials for all apps)
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# Razorpay (single account)
RAZORPAY_KEY_ID="rzp_live_xxx"
RAZORPAY_KEY_SECRET="xxx"
RAZORPAY_WEBHOOK_SECRET="xxx"  # set once in Razorpay dashboard, same for all apps

# AWS
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="xxx"
SES_FROM_EMAIL="contact@influxwise.com"

# Upstash Redis (serverless REST — free tier)
UPSTASH_REDIS_URL="https://xxx.upstash.io"
UPSTASH_REDIS_TOKEN="xxx"

# Spark-specific
SPARK_S3_BUCKET="influxwise-spark-uploads"
SPARK_SQS_QUEUE_URL="https://sqs.us-west-2.amazonaws.com/377002869088/influxwise-spark-jobs"
ANTHROPIC_API_KEY="sk-ant-xxx"
